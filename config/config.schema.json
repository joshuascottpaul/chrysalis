{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://neocode.com/chrysalis/config.schema.json",
  "title": "chrysalis config",
  "description": "Per-upgrade configuration for chrysalis. Implements SDD section 5.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target_version",
    "installers",
    "fms",
    "backup_root",
    "shutdown_sequence",
    "startup_sequence"
  ],
  "properties": {
    "target_version": {
      "type": "string",
      "description": "Semver-ish version string. Must have a matching entry under 'installers'.",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "upgrade_mode": {
      "type": "string",
      "description": "in_place is appropriate for minor/patch bumps. uninstall_reinstall is required for major-version jumps.",
      "enum": ["in_place", "uninstall_reinstall"]
    },
    "installers": {
      "type": "object",
      "description": "Version registry. Keys are semver-ish version strings; values describe per-platform installers.",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^\\d+\\.\\d+\\.\\d+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["windows", "macos", "linux", "sha256"],
        "properties": {
          "windows": {
            "type": "string",
            "format": "uri",
            "minLength": 1
          },
          "macos": {
            "type": "string",
            "format": "uri",
            "minLength": 1
          },
          "linux": {
            "type": "string",
            "format": "uri",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "description": "Lowercase hex SHA-256 of the installer payload. 64 hex characters.",
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        }
      }
    },
    "fms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["install_root_windows", "admin_port", "creds_file"],
      "properties": {
        "install_root_windows": {
          "type": "string",
          "minLength": 1
        },
        "install_root_macos": {
          "type": "string",
          "minLength": 1
        },
        "install_root_linux": {
          "type": "string",
          "minLength": 1
        },
        "admin_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "creds_file": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "backup_root": {
      "type": "string",
      "minLength": 1,
      "description": "Root directory under which timestamped backup folders are written."
    },
    "max_backup_age_hours": {
      "type": "integer",
      "minimum": 1,
      "default": 24,
      "description": "Pre-flight 2g freshness threshold. A native FMS DB backup older than this fails pre-flight."
    },
    "shutdown_sequence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "startup_sequence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
